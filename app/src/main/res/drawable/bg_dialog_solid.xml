<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <!-- Solid background for dialogs to prevent text bleed-through -->
    <solid android:color="@color/bg_dark_center" />
    
    <!-- Thin light stroke/border for glass reflection edge -->
    <stroke
        android:width="2dp"
        android:color="@color/glass_card_stroke" />
    
    <!-- Rounded corners for modern look -->
    <corners android:radius="24dp" />
</shape>
