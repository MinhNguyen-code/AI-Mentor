<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <!-- Semi-transparent gradient fill -->
    <gradient
        android:startColor="#2000E5FF"
        android:centerColor="#18121B2A"
        android:endColor="#206366F1"
        android:angle="45"
        android:type="linear" />
    
    <!-- Light glowing cyan border -->
    <stroke
        android:width="1.2dp"
        android:color="#4D00E5FF" />
    
    <corners android:radius="18dp" />
</shape>
