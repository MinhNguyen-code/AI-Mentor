<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_glossy_dark">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="24dp">

            <!-- Title Header -->
            <TextView
                android:id="@+id/tvUniversityName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="BTEC FPT - Pearson UK"
                android:textColor="@color/text_secondary"
                android:textSize="14sp"
                android:textStyle="bold"
                android:letterSpacing="0.1"
                android:layout_marginTop="16dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>

            <!-- Screen Title -->
            <TextView
                android:id="@+id/tvScreenTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Create New Course"
                android:textColor="@color/white"
                android:textSize="24sp"
                android:textStyle="bold"
                android:layout_marginTop="16dp"
                app:layout_constraintTop_toBottomOf="@id/tvUniversityName"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>

            <!-- Glossy Card Form -->
            <LinearLayout
                android:id="@+id/formCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/card_glossy_glass"
                android:padding="24dp"
                android:layout_marginTop="20dp"
                app:layout_constraintTop_toBottomOf="@id/tvScreenTitle"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">



                <!-- Course Title Input -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilCourseTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:hint="Course Title"
                    app:hintTextColor="@color/accent_blue"
                    app:boxStrokeColor="@color/accent_blue"
                    app:boxStrokeWidth="1dp"
                    app:boxStrokeWidthFocused="2dp"
                    app:startIconTint="@color/text_secondary"
                    android:textColorHint="@color/text_secondary"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edtCourseTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_primary"
                        android:inputType="textCapWords"
                        android:maxLines="1"/>
                </com.google.android.material.textfield.TextInputLayout>



                <!-- Description Input -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilCourseDesc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:hint="Course Description..."
                    app:hintTextColor="@color/accent_blue"
                    app:boxStrokeColor="@color/accent_blue"
                    app:boxStrokeWidth="1dp"
                    app:boxStrokeWidthFocused="2dp"
                    app:startIconTint="@color/text_secondary"
                    android:textColorHint="@color/text_secondary"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edtCourseDesc"
                        android:layout_width="match_parent"
                        android:layout_height="120dp"
                        android:textColor="@color/text_primary"
                        android:inputType="textMultiLine"
                        android:gravity="top|start"
                        android:scrollbars="vertical"/>
                </com.google.android.material.textfield.TextInputLayout>

                <!-- AI Explanation Style -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="AI Explanation Style"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginTop="20dp"
                    android:layout_marginBottom="8dp"/>

                <RadioGroup
                    android:id="@+id/rgExplanationStyle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <RadioButton
                        android:id="@+id/rbStyleShort"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Short &amp; Concise (1-2 weeks)"
                        android:textColor="@color/text_primary"/>

                    <RadioButton
                        android:id="@+id/rbStyleDetailed"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Detailed with Examples (3-4 weeks)"
                        android:textColor="@color/text_primary"/>

                    <RadioButton
                        android:id="@+id/rbStyleStepByStep"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Step-by-Step Breakdown (1-2 months)"
                        android:textColor="@color/text_primary"
                        android:checked="true"/>
                </RadioGroup>

                <!-- Save Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSaveCourse"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="Save Course"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/white"
                    android:layout_marginTop="24dp"
                    app:backgroundTint="@color/accent_blue_dark"
                    app:cornerRadius="12dp"
                    app:rippleColor="@color/white"/>

                <!-- Cancel/Back Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnBackCourse"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="Cancel"
                    android:textSize="16sp"
                    android:textColor="@color/text_secondary"
                    android:layout_marginTop="12dp"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    app:strokeColor="@color/glass_card_stroke"
                    app:cornerRadius="12dp"/>

            </LinearLayout>

            <!-- Footer -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Copyright © 2026 Pearson BTEC"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:layout_marginTop="32dp"
                android:layout_marginBottom="16dp"
                app:layout_constraintTop_toBottomOf="@id/formCard"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
