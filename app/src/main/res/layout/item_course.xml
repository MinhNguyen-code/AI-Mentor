<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="6dp">

    <!-- Glossy Card Container -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/card_glossy_glass"
        android:padding="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- Course Code -->
            <TextView
                android:id="@+id/tvCourseCode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SD201"
                android:textColor="@color/accent_blue"
                android:textSize="13sp"
                android:textStyle="bold"
                android:background="@drawable/card_glossy_glass"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"/>

            <!-- Credits Badge -->
            <TextView
                android:id="@+id/tvCourseCredits"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="15 Credits"
                android:textColor="@color/accent_purple"
                android:textSize="12sp"
                android:textStyle="bold"
                android:background="@drawable/card_glossy_glass"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2dp"
                android:layout_toEndOf="@id/tvCourseCode"
                android:layout_marginStart="8dp"
                android:layout_centerVertical="true"/>

            <!-- Delete Icon -->
            <ImageView
                android:id="@+id/btnDeleteCourse"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@android:drawable/ic_menu_delete"
                app:tint="@color/error"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:padding="4dp"
                android:contentDescription="Delete Course"/>

        </RelativeLayout>

        <!-- Course Title -->
        <TextView
            android:id="@+id/tvCourseTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Programming"
            android:textColor="@color/text_primary"
            android:textSize="17sp"
            android:textStyle="bold"
            android:layout_marginTop="10dp"/>

        <!-- Course Description -->
        <TextView
            android:id="@+id/tvCourseDesc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Learn OOP concepts in Java/C# and build basic projects."
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:layout_marginTop="6dp"
            android:maxLines="3"
            android:ellipsize="end"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="12dp"
            android:weightSum="2">
            
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnKahootQuiz"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:text="Kahoot"
                android:textColor="@color/white"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginEnd="4dp"
                app:backgroundTint="@color/accent_purple"
                app:cornerRadius="10dp"
                app:rippleColor="@color/white" />
                
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnViewProgress"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:text="Progress"
                android:textColor="@color/white"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginStart="4dp"
                app:backgroundTint="@color/accent_blue"
                app:cornerRadius="10dp"
                app:rippleColor="@color/white" />
                
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEnrollCourse"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:text="Enroll Now"
                android:textColor="@color/white"
                android:textSize="13sp"
                android:textStyle="bold"
                android:visibility="gone"
                app:backgroundTint="@color/success"
                app:cornerRadius="10dp"
                app:rippleColor="@color/white" />
        </LinearLayout>

    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
